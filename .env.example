# ==============================================================================
# NEXORA — Environment configuration
# Copy this file to .env and fill in real values. NEVER commit real secrets.
# ==============================================================================

# ---- Core --------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (PostgreSQL) ---------------------------------------------------
# Matches infra/docker-compose.yml defaults for local development.
DATABASE_URL=mongodb://localhost:27017/nexora?replicaSet=rs0

# ---- Redis (optional — falls back to in-memory cache when absent) -----------
REDIS_URL=redis://localhost:6379

# ---- Discord -----------------------------------------------------------------
# Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- URLs & ports ------------------------------------------------------------
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
BOT_HEALTH_PORT=4001
ADMIN_URL=http://localhost:3001

# ---- Secrets -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to sign sessions / encrypt sensitive values at rest.
ENCRYPTION_KEY=
# NextAuth (Auth.js v5) secret for the dashboard app.
AUTH_SECRET=
# NextAuth secret for the admin app (use a DIFFERENT value than AUTH_SECRET).
AUTH_SECRET_ADMIN=

# ---- Sharding ----------------------------------------------------------------
# "auto" lets discord.js compute the shard count, or set an explicit number.
SHARD_COUNT=auto

# ---- Payments (optional — payment provider abstraction, never hardcode creds) -
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI features (optional — all AI features are off unless configured) ------
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
